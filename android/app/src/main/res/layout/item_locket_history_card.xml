<?xml version="1.0" encoding="utf-8"?>
<!--
  Locket-style history card: same size/shape as camera card.
  One card per "page" in the vertical ViewPager2 feed.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_xs">

    <!-- Top bar: sender avatar (left) | "Mọi người ▼" (center) | user avatar (right) -->
    <ImageView
        android:id="@+id/iv_sender_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_avatar"
        android:contentDescription="Sender"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_feed_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_more_tab"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:padding="6dp"
        android:text="Mọi người"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_sender_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_sender_avatar" />

    <View
        android:id="@+id/iv_my_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Photo Card: 3:4 ratio, same as camera card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_history_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="@dimen/corner_camera"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_sender_info"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_sender_avatar"
        app:strokeColor="@color/input_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Photo -->
            <ImageView
                android:id="@+id/iv_history_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Expense photo"
                android:scaleType="centerCrop" />

            <!-- Bottom gradient scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_gradient_scrim" />

            <!-- Caption overlay (Locket style pill) -->
            <TextView
                android:id="@+id/tv_history_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_caption_overlay"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sender info below card -->
    <LinearLayout
        android:id="@+id/layout_sender_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layout_reactions"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_avatar"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sender_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <!-- Reactions / quick reply row -->
    <LinearLayout
        android:id="@+id/layout_reactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/spacing_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Message input mock -->
        <TextView
            android:id="@+id/tv_reply_hint"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Tin nhắn..."
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_sm" />

        <!-- Amount chip -->
        <TextView
            android:id="@+id/tv_history_amount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_caption_overlay"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/primary_accent"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
