<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/ripple_light"
    app:strokeColor="@color/input_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Left Icon Container -->
        <FrameLayout
            android:id="@+id/layout_icon_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_notification_icon_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="20sp"
                tools:text="⚠️" />
        </FrameLayout>

        <!-- Top metadata row: Type Tag Pill + Time + Unread Dot -->
        <LinearLayout
            android:id="@+id/layout_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/view_unread_dot"
            app:layout_constraintStart_toEndOf="@id/layout_icon_container"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_type_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_caption_overlay"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/accent_neon_yellow"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="CẢNH BÁO" />

            <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                tools:text="10 phút trước" />
        </LinearLayout>

        <!-- Unread Indicator Dot -->
        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_meta"
            app:layout_constraintBottom_toBottomOf="@id/layout_meta" />

        <!-- Notification Title -->
        <TextView
            android:id="@+id/tv_notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_icon_container"
            app:layout_constraintTop_toBottomOf="@id/layout_meta"
            tools:text="Cảnh báo hạn mức chi tiêu" />

        <!-- Notification Message Body -->
        <TextView
            android:id="@+id/tv_notification_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_icon_container"
            app:layout_constraintTop_toBottomOf="@id/tv_notification_title"
            tools:text="Chi tiêu 'Ăn uống' tháng này đã đạt 85% hạn mức (1.700.000 ₫ / 2.000.000 ₫)." />

        <!-- Action / Navigation Hint -->
        <TextView
            android:id="@+id/tv_action_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent_neon_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/layout_icon_container"
            app:layout_constraintTop_toBottomOf="@id/tv_notification_message"
            tools:text="👉 Nhấn để xem Thống kê chi tiết" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
