<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="6dp">

    <!-- Bot Message Layout (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layout_bot_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iv_bot_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Bot"
            android:padding="4dp"
            android:src="@drawable/ic_logo_set" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_bot_bubble"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_bot_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bot_welcome_message"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/tv_bot_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="12:00"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- User Message Layout (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_user_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_user_bubble"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_user_message"
                android:textColor="@color/on_primary_accent"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="12:01"
                android:textColor="@color/on_primary_accent"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
