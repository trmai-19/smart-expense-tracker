<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_xl">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_palette" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/palette_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn màu sắc Neon rực rỡ cho ứng dụng"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@color/divider_color" />

    <!-- 8 Neon Color Swatches (Row 1 - 4 items) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1. Neon Lime -->
        <LinearLayout
            android:id="@+id/item_color_lime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_lime_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_lime" />

                <ImageView
                    android:id="@+id/iv_lime_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Xanh Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 2. Neon Cyan -->
        <LinearLayout
            android:id="@+id/item_color_cyan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_cyan_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_cyan" />

                <ImageView
                    android:id="@+id/iv_cyan_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Xanh Cyan"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 3. Neon Yellow -->
        <LinearLayout
            android:id="@+id/item_color_yellow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_yellow_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_yellow" />

                <ImageView
                    android:id="@+id/iv_yellow_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Vàng Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 4. Neon Pink -->
        <LinearLayout
            android:id="@+id/item_color_pink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_pink_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_pink" />

                <ImageView
                    android:id="@+id/iv_pink_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hồng Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 (4 items) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 5. Neon Purple -->
        <LinearLayout
            android:id="@+id/item_color_purple"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_purple_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_purple" />

                <ImageView
                    android:id="@+id/iv_purple_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tím Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 6. Neon Orange -->
        <LinearLayout
            android:id="@+id/item_color_orange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_orange_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_orange" />

                <ImageView
                    android:id="@+id/iv_orange_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cam Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 7. Neon Mint -->
        <LinearLayout
            android:id="@+id/item_color_mint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_mint_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_mint" />

                <ImageView
                    android:id="@+id/iv_mint_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Xanh Mint"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 8. Neon Coral -->
        <LinearLayout
            android:id="@+id/item_color_coral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/view_coral_circle"
                    android:layout_width="@dimen/color_swatch_size"
                    android:layout_height="@dimen/color_swatch_size"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/accent_neon_coral" />

                <ImageView
                    android:id="@+id/iv_coral_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Đỏ Neon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
