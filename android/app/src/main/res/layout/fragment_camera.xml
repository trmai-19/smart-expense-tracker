<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera & Timeline Feed Screen — Pure Locket UX:
  - Vertical ViewPager2: Timeline Feed (Page 0 = Camera; Page 1..N = Fullscreen Expense Cards)
  - 3-Column Widget Grid: Visible when widget mode is active
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- ───────────────────────────────────────────── -->
    <!-- 1. Vertical ViewPager2: Timeline Feed -->
    <!-- Page 0: Camera Live View | Page 1..N: Past Expenses -->
    <!-- ───────────────────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_timeline_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ───────────────────────────────────────────── -->
    <!-- 2. Widget Grid View (3-Column Photo Grid) -->
    <!-- ───────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_grid_expenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
