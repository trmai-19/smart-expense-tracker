<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- ───────────────────────────────────────────── -->
        <!-- Time Filter Row (Tuần | Tháng | Năm | Tùy chọn) -->
        <!-- ───────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_time_filters"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Tuần (Week) -->
            <TextView
                android:id="@+id/btn_filter_week"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_caption_overlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Tuần"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold" />

            <!-- 2. Tháng (Month) - Default Active -->
            <TextView
                android:id="@+id/btn_filter_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_caption_overlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Tháng"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold" />

            <!-- 3. Năm (Year) -->
            <TextView
                android:id="@+id/btn_filter_year"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_caption_overlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Năm"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold" />

            <!-- 4. Tùy chọn (Date to Date) -->
            <TextView
                android:id="@+id/btn_filter_custom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:background="@drawable/bg_caption_overlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Tùy chọn 📅"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ───────────────────────────────────────────── -->
        <!-- Hero Card: Total Spending in Period -->
        <!-- ───────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SET.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tv_total_period_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng chi tiêu tháng này"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tv_total_spent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="@string/sample_monthly_spent"
                    android:textColor="@color/primary_accent"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_comparison_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="↓ 12% so với kỳ trước"
                    android:textColor="@color/status_success"
                    android:textSize="@dimen/text_xs"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ───────────────────────────────────────────── -->
        <!-- Category Breakdown Card -->
        <!-- ───────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SET.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/category_breakdown_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <!-- Category 1: Ăn uống -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍜 Ăn uống (45%)"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_category_food_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="562.500 ₫"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="45"
                        android:progressBackgroundTint="@color/divider_color"
                        android:progressTint="@color/accent_neon_orange" />
                </LinearLayout>

                <!-- Category 2: Di chuyển -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛵 Di chuyển (20%)"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_category_transport_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="250.000 ₫"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="20"
                        android:progressBackgroundTint="@color/divider_color"
                        android:progressTint="@color/accent_neon_cyan" />
                </LinearLayout>

                <!-- Category 3: Mua sắm -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛍️ Mua sắm (15%)"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_category_shopping_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="187.500 ₫"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="15"
                        android:progressBackgroundTint="@color/divider_color"
                        android:progressTint="@color/accent_neon_pink" />
                </LinearLayout>

                <!-- Category 4: Khác -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 Khác (20%)"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_category_other_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="250.000 ₫"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="20"
                        android:progressBackgroundTint="@color/divider_color"
                        android:progressTint="@color/accent_neon_lime" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ───────────────────────────────────────────── -->
        <!-- 7-Day Trend Chart Card -->
        <!-- ───────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SET.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tv_trend_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/weekly_trend_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <!-- Bar chart representation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <!-- Day 1: T2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_1"
                            android:layout_width="14dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T2"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 2: T3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_2"
                            android:layout_width="14dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T3"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 3: T4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_3"
                            android:layout_width="14dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T4"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 4: T5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_4"
                            android:layout_width="14dp"
                            android:layout_height="90dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T5"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 5: T6 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_5"
                            android:layout_width="14dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T6"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 6: T7 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_6"
                            android:layout_width="14dp"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="T7"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Day 7: CN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/bar_day_7"
                            android:layout_width="14dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_caption_overlay" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="CN"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
