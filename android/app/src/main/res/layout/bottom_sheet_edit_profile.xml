<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_edit_header_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_edit" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa hồ sơ cá nhân"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật tên hiển thị, avatar và ngân sách"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@color/divider_color" />

        <!-- Avatar Preview + Quick Emoji Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Selected Avatar Preview -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/iv_preview_avatar_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_avatar" />

                <TextView
                    android:id="@+id/tv_preview_avatar_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⭐"
                    android:textSize="32sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Chọn biểu tượng đại diện:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Horizontal Emoji Quick Selector -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_emoji_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Emojis populated in code or here -->
                    <TextView
                        android:id="@+id/emoji_star"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="⭐"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_crown"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="👑"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_rocket"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="🚀"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_cat"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="🐱"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_fire"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="🔥"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_target"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="🎯"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_money"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="💰"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emoji_food"
                        style="@style/Widget.SET.Card"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="🍜"
                        android:textSize="20sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 1. Display Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:hint="Tên hiển thị"
            android:textColorHint="@color/text_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
            app:boxCornerRadiusBottomStart="@dimen/corner_md"
            app:boxCornerRadiusTopEnd="@dimen/corner_md"
            app:boxCornerRadiusTopStart="@dimen/corner_md"
            app:boxStrokeColor="@color/input_border">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                tools:text="Nguyễn Văn A" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:hint="Địa chỉ Email"
            android:textColorHint="@color/text_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
            app:boxCornerRadiusBottomStart="@dimen/corner_md"
            app:boxCornerRadiusTopEnd="@dimen/corner_md"
            app:boxCornerRadiusTopStart="@dimen/corner_md"
            app:boxStrokeColor="@color/input_border">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                tools:text="user@smartexpense.app" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Phone Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_phone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:hint="Số điện thoại"
            android:textColorHint="@color/text_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
            app:boxCornerRadiusBottomStart="@dimen/corner_md"
            app:boxCornerRadiusTopEnd="@dimen/corner_md"
            app:boxCornerRadiusTopStart="@dimen/corner_md"
            app:boxStrokeColor="@color/input_border">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                tools:text="0912 345 678" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. Monthly Budget Target Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_budget"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:hint="Mục tiêu hạn mức chi tiêu tháng (₫)"
            android:textColorHint="@color/text_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
            app:boxCornerRadiusBottomStart="@dimen/corner_md"
            app:boxCornerRadiusTopEnd="@dimen/corner_md"
            app:boxCornerRadiusTopStart="@dimen/corner_md"
            app:boxStrokeColor="@color/input_border">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                tools:text="5000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons: Cancel | Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_edit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Hủy"
                android:textColor="@color/text_secondary"
                app:cornerRadius="@dimen/corner_md"
                app:strokeColor="@color/input_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_neon_yellow"
                android:text="Lưu thay đổi"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:cornerRadius="@dimen/corner_md" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
