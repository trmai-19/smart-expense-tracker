<?xml version="1.0" encoding="utf-8"?>
<!--
  Locket Grid / Widget Item:
  Square 1:1 rounded tile with photo, subtle gradient, caption and amount
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/bg_surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1:1 Square Container -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_grid_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_surface"
                android:contentDescription="Ảnh lưới chi tiêu"
                android:scaleType="centerCrop" />

            <!-- Gradient Scrim for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_gradient_scrim" />

            <!-- Mini Amount Pill (Top Right) -->
            <TextView
                android:id="@+id/tv_grid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_caption_overlay"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="50k"
                android:textColor="@color/primary_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Mini Caption (Bottom) -->
            <TextView
                android:id="@+id/tv_grid_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="Bún bò huế"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
