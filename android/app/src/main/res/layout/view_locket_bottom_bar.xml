<?xml version="1.0" encoding="utf-8"?>
<!--
  Locket-style Bottom Navigation Bar:
  5 slots:
  1. [Widget / Grid] -> Lưới ảnh widget lịch sử
  2. [Dashboard]     -> Thống kê chi tiêu
  3. [Center Button] -> Hiện ở các trang 1..N để bấm về nhanh Camera; Ẩn ở trang 0
  4. [Chatbot AI]    -> Trợ lý tài chính thông minh
  5. [Palette/Theme] -> Chọn màu chủ đạo hệ thống
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bottom_bar_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/bg_main"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 1: Widget / Grid history toggle -->
    <LinearLayout
        android:id="@+id/btn_nav_grid"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_nav_grid"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:alpha="0.55"
            android:contentDescription="Lưới ảnh chi tiêu"
            android:src="@drawable/ic_grid_widget" />
    </LinearLayout>

    <!-- 2: Dashboard / Stats -->
    <LinearLayout
        android:id="@+id/btn_nav_dashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_nav_dashboard"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:alpha="0.55"
            android:contentDescription="Thống kê chi tiêu"
            android:src="@drawable/ic_dashboard_tab" />
    </LinearLayout>

    <!-- 3: Center Shutter Button (Visible on History pages 1..N to return to Camera; Invisible on Page 0) -->
    <FrameLayout
        android:id="@+id/btn_nav_shutter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible">

        <!-- Outer Ring (tinted to accent color) -->
        <View
            android:id="@+id/view_shutter_ring"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_shutter_outer" />

        <!-- Inner Solid Button -->
        <View
            android:id="@+id/iv_shutter_inner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_shutter_inner" />

    </FrameLayout>

    <!-- 4: Chatbot AI -->
    <FrameLayout
        android:id="@+id/btn_nav_chat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_nav_chat"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:contentDescription="Trợ lý AI"
            android:src="@drawable/ic_chat" />

        <!-- Notification Badge Dot -->
        <View
            android:id="@+id/badge_chat"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_dot"
            android:visibility="visible" />
    </FrameLayout>

    <!-- 5: Palette / Theme -->
    <LinearLayout
        android:id="@+id/btn_nav_palette"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_nav_palette"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:alpha="0.55"
            android:contentDescription="Đổi màu chủ đạo"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

</LinearLayout>
