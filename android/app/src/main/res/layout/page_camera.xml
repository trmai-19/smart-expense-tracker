<?xml version="1.0" encoding="utf-8"?>
<!-- Camera page inside the Locket feed vertical ViewPager2 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="60dp"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_xs">

    <!-- Hidden avatar placeholder for adapter binding (actual avatar is in the floating top bar) -->
    <View
        android:id="@+id/iv_top_avatar"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@drawable/bg_circle_avatar"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3:4 Viewfinder Card with Rounded Corners (Locket-style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_viewfinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="@dimen/corner_camera"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_camera_controls"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/input_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- CameraX Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/preview_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Placeholder when camera not available -->
            <ImageView
                android:id="@+id/iv_camera_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_surface"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Hint text -->
            <TextView
                android:id="@+id/tv_camera_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:text="Chụp ảnh chi tiêu của bạn"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Camera Controls: Gallery | Shutter | Flip -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_gallery"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Gallery"
            android:src="@drawable/ic_gallery"
            app:layout_constraintBottom_toBottomOf="@id/layout_shutter"
            app:layout_constraintEnd_toStartOf="@id/layout_shutter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_shutter" />

        <FrameLayout
            android:id="@+id/layout_shutter"
            android:layout_width="@dimen/shutter_size_outer"
            android:layout_height="@dimen/shutter_size_outer"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="@dimen/shutter_size_outer"
                android:layout_height="@dimen/shutter_size_outer"
                android:background="@drawable/ic_shutter_outer" />

            <View
                android:id="@+id/btn_shutter_inner"
                android:layout_width="@dimen/shutter_size_inner"
                android:layout_height="@dimen/shutter_size_inner"
                android:layout_gravity="center"
                android:background="@drawable/ic_shutter_inner" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_flip_camera"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Flip Camera"
            android:src="@drawable/ic_flip_camera"
            app:layout_constraintBottom_toBottomOf="@id/layout_shutter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_shutter"
            app:layout_constraintTop_toTopOf="@id/layout_shutter" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
