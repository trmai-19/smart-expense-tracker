<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rounded Button with Accent Color — no internal padding; height is set per-view -->
    <style name="Widget.SET.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/on_primary_accent</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/primary_accent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Outlined Rounded Button -->
    <style name="Widget.SET.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Dark Rounded Card -->
    <style name="Widget.SET.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_surface_card</item>
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Dark Text Input Layout -->
    <style name="Widget.SET.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="ThemeOverlay.SET.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SET.BottomSheet.Modal</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Widget.SET.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
